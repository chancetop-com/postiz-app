# ============================================================
# Public build configuration for the Next.js browser bundle (ticket 13)
#
# ONLY NEXT_PUBLIC_* values belong here. `next build` inlines them into the
# browser (and server-rendered) output, so a value supplied at runtime through
# the deployment's `envFrom` cannot change what the browser already received.
#
# The list is exactly the set of NEXT_PUBLIC_* names the source reads
# (enforced by ./tests/runtime-contract.test.sh). A new public value must be
# added here, to the Dockerfile ARG/ENV block and to the source together.
#
# No secret belongs in this file: everything here ends up in a public bundle.
# Empty values mean "not enabled"; they are still passed so the build cannot
# inherit an unrelated value from the build host.
#
# Values, and why:
#   NEXT_PUBLIC_BACKEND_URL            browser API is same-origin /api
#   NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY uploaded media live under /uploads
#   NEXT_PUBLIC_SSO_PARENT_ORIGINS     the known parent application origin the
#                                      /sso page accepts postMessage from
#                                      (client-side check only; the server-side
#                                      SSO_PARENT_ORIGINS value is not an
#                                      enforced restriction)
#   the rest                          optional switches/identifiers, disabled
#                                      in this profile (GTM download included)
# ============================================================
NEXT_PUBLIC_BACKEND_URL=/api
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/uploads
NEXT_PUBLIC_SSO_PARENT_ORIGINS=https://merchant.connexup-dev.net
NEXT_PUBLIC_VERSION=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_POLOTNO=
NEXT_PUBLIC_FACEBOOK_PIXEL=
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=
NEXT_PUBLIC_TRACKING_TRIAL=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_OVERRIDE_BACKEND_URL=
